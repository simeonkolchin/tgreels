# ── Telegram API credentials ──────────────────────────────
# Получи здесь: https://my.telegram.org → API development tools
API_ID=1234567
API_HASH=your_api_hash_here

# ── Пути (внутри контейнера) ──────────────────────────────
# ВНИМАНИЕ: в docker-compose SESSION_PATH переопределяется per-service
# (api → /app/data/session/api, worker → /app/data/session/worker),
# т.к. одну .session нельзя шарить между процессами. Значение ниже —
# только для локального запуска без докера.
SESSION_PATH=/app/data/session/userbot
DB_PATH=/app/data/videos.db

# ── Сервер ────────────────────────────────────────────────
PORT=8000

# ── Индексатор ────────────────────────────────────────────
# Как часто пере-сканировать каналы на новые видео (часы)
INDEX_INTERVAL_HOURS=12
# Сколько сообщений сканировать при ПЕРВОМ проходе на канал (0 = вся история)
MAX_HISTORY_PER_CHANNEL=0
# Брать только вертикальные ролики (h >= w)
VERTICAL_ONLY=true
# Включать megagroup-супергруппы, а не только broadcast-каналы
INCLUDE_GROUPS=false
